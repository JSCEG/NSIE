                                        </label>
                                    </div>
                                    <div class="subpanel-permiso d-none mt-2 p-3"
                                         style="border:2px solid #c9a86a; border-radius:6px;">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold">Permisos y autorizaciones</label>
                                                <div class="permisos-lista">
