                                                        <label class="form-check-label">
                                                            Ocupación y Obras de infraestructura en cauces y zonas federales
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Permiso de descarga de aguas residuales">
                                                        <label class="form-check-label">
                                                            Permiso de descarga de aguas residuales
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
