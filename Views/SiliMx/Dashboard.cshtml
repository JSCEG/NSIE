                                        "Cambio de Uso de Suelo en Terrenos Forestales (CUSTF)",
                                        "Estudio de Riesgo Ambiental (ERA)",
                                        "Programa para la Prevención de Accidentes (PPA)",
                                        "Licencia Ambiental Única (LAU)","Registro de Plan de Manejo",
                                        "Cédula de Operación Anual (COA)",
                                        "Programa de Restauración, Cierre y Post-Cierre de Minas"} },
                                    new { Id="CONAGUA", Label="CONAGUA - Comisión Nacional del Agua",
                                        Opciones=new[]{"Concesión de aguas nacionales",
                                        "Ocupación y Obras de infraestructura en cauces y zonas federales",
                                        "Permiso de descarga de aguas residuales"} },
                                    new { Id="SEDENA", Label="SEDENA - Secretaría de la Defensa Nacional",
                                        Opciones=new[]{"Uso de explosivos"} },
                                    new { Id="INAH", Label="INAH - Instituto Nacional de Antropología e Historia",
                                        Opciones=new[]{"Carta de liberación"} },
                                    new { Id="SE", Label="SE - Secretaría de Economía",
                                        Opciones=new[]{"Informes","Título de concesión minera",
                                        "Inscripción en el Registro Público de Minería","Plan de Cierre de Mina"} },
                                    new { Id="Otros", Label="Otros",
                                        Opciones=new[]{"IMSS e INFONAVIT: inscripción de empresa y trabajadores",
                                        "SHCP: Registro como persona física o moral con actividad empresarial"} }
                                })
                                {
                                    <div class="permiso-bloque-act mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="checkbox" class="chk-inst-act"
                                                style="width:24px;height:24px;"
                                                data-inst="@inst.Id"
                                                id="act-chk-@inst.Id" />
                                            <label for="act-chk-@inst.Id" class="mb-0">@inst.Label</label>
                                        </div>
                                        <div class="subpanel-act d-none mt-2 p-3"
                                            style="border:2px solid #c9a86a; border-radius:6px;">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-semibold">
                                                        Permisos y autorizaciones
                                                    </label>
                                                    <div class="lista-permisos-act">
                                                        @foreach (var op in inst.Opciones)
                                                        {
                                                            <div class="form-check mb-2">
                                                                <input class="form-check-input permiso-item-act"
                                                                    type="checkbox"
                                                                    value="@op"
                                                                    id="act-@inst.Id-@op.Replace(" ","").Replace("/","").Replace("(","").Replace(")","")" />

                                                                <label class="form-check-label"
                                                                    for="act-@inst.Id-@op.Replace(" ","").Replace("/","").Replace("(","").Replace(")","")">
                                                                    @op
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-semibold">
                                                        Otro (especifique)
                                                    </label>
                                                    <input type="text" class="form-control otro-esp-act" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="d-flex align-items-center gap-2 mt-2">
                                    <input type="checkbox" id="act-chk-NoAplica"
                                        style="width:24px;height:24px;" />
                                    <label for="act-chk-NoAplica" class="mb-0 text-muted">No aplica</label>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary px-4"
                                        onclick="irAPasoAct(1)">← Anterior</button>
                                <button class="btn px-4 text-white" style="background-color:#c9a86a;"
                                        onclick="irAPasoAct(3)">Siguiente →</button>
                            </div>
                        </div>

                        @* {{-- PASO A3: Notas y Evidencias --}} *@
                        <div id="actPaso3" class="act-wizard-paso d-none">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold">
                                        Resuma los avances obtenidos
                                        <span class="badge ms-2 px-2"
                                            style="background:#f0ede8; color:#888;
                                                    font-size:0.7rem; font-weight:400;">
                                            Agregar pregunta
                                        </span>
                                    </label>
                                    <textarea id="act-ResumenAvances" class="form-control" rows="4"></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Notas finales</label>
                                    <textarea id="act-NotasFinales" class="form-control" rows="4"></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Evidencias</label>
                                    <div class="d-flex align-items-center gap-3 p-3"
                                        style="border:1px solid #dee2e6; border-radius:6px;">
                                        <button type="button" class="btn text-white px-3"
                                                style="background-color:#621132;"
                                                onclick="document.getElementById('act-inputEvidencias').click()">
                                            Elegir archivos
                                        </button>
                                        <span id="act-lblEvidencias" class="text-muted small">
                                            Ningún archivo seleccionado
                                        </span>
                                        <input type="file" id="act-inputEvidencias" multiple accept=".xlsx,.xls" class="d-none"
                                            onchange="mostrarNombresAct(this)" />
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary px-4"
                                        onclick="irAPasoAct(2)">← Anterior</button>
                                <button class="btn px-4 text-white" style="background-color:#1b4332;"
                                        id="btnGuardarActualizacion">
                                    <span id="txtGuardarAct">Guardar</span>
                                    <span id="spnGuardarAct"
                                        class="spinner-border spinner-border-sm ms-1 d-none"></span>
                                </button>
                            </div>
                        </div>

                    </div>
                    @* {{-- /wizardActualizar --}} *@
                </div>
            </div>
        </div>

    </div>
    @* {{-- /acordeón --}} *@

    @* {{-- Botones inferiores --}} *@
    <div class="d-flex justify-content-between align-items-center mt-2">
        <div>
            @if (esDirectivo)
            {
                <a href="@Url.Action("Aprobaciones", "SiliMx")"
                   class="btn btn-sm btn-outline-secondary px-3"
                   style="font-size:0.82rem; border-color:#999; color:#666;">
                    <i class="bi bi-person-check me-1"></i> Aprobaciones
                </a>
            }
        </div>
        <a href="@Url.Action("CatalogoProyectos", "SiliMx")"
           class="btn px-4"
           style="background-color:#e8e8e8; color:#333; border:1px solid #ccc; font-weight:500;">
            Catálogo de Proyectos
        </a>
    </div>

</div>

@* {{-- Modal de confirmación al guardar --}} *@
<div class="modal fade" id="modalProyectoGuardado" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:10px;">
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <span style="width:48px;height:48px;border-radius:50%;background:#1b4332;
                                 display:inline-flex;align-items:center;justify-content:center;">
                        <i class="bi bi-check-lg text-white fs-4"></i>
                    </span>
                </div>
                <h5 class="fw-bold">Proyecto guardado</h5>
                <div class="p-3 mt-2" style="background:#f8f8f8; border-radius:6px; font-size:0.9rem;">
                    1. Proyecto guardado correctamente.<br>
                    2. ID del Proyecto: <strong id="idProyectoGenerado">—</strong>
                </div>
                <button class="btn mt-4 px-4 text-white" style="background-color:#1b4332;"
                        data-bs-dismiss="modal" onclick="resetearWizard()">
                    <i class="bi bi-check me-1"></i> Entendido
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ===== WIZARD =====
    var pasoActual = 1;

    function irAPaso(numero) {
        if (numero === 2 && !validarPaso1()) return;

        document.querySelectorAll('.wizard-paso').forEach(function (el) {
            el.classList.add('d-none');
        });
        document.getElementById('paso' + numero).classList.remove('d-none');

        for (var i = 1; i <= 3; i++) {
            var tab = document.getElementById('paso-tab-' + i);
            if (i === numero) {
                tab.style.backgroundColor = '#1b4332';
                tab.style.color = 'white';
                tab.style.cursor = 'pointer';
            } else if (i < numero) {
                tab.style.backgroundColor = '#c9a86a';
                tab.style.color = 'white';
                tab.style.cursor = 'pointer';
            } else {
                tab.style.backgroundColor = '#e0e0e0';
                tab.style.color = '#666';
                tab.style.cursor = 'default';
            }
        }
        pasoActual = numero;
    }

    function validarPaso1() {
        var requeridos = ['TipoProyecto', 'ProyectoID', 'NombreProyecto', 'DescripcionObjetivo'];
        var valido = true;
        requeridos.forEach(function (id) {
            var el = document.getElementById(id);
            if (!el.value || !el.value.trim()) {
                el.classList.add('is-invalid');
                valido = false;
            } else {
                el.classList.remove('is-invalid');
            }
        });
        if (!valido) alert('Por favor completa los campos obligatorios del Paso 1.');
        return valido;
    }

    // ===== PERMISOS: mostrar/ocultar subpanel =====
    document.querySelectorAll('.chk-institucion').forEach(function (chk) {
        chk.addEventListener('change', function () {
            var bloque = this.closest('.permiso-bloque');
            var subpanel = bloque.querySelector('.subpanel-permiso');
            var label = bloque.querySelector('label');

            if (this.checked) {
                subpanel.classList.remove('d-none');
                label.style.fontWeight = 'bold';
                label.style.color = '#1b4332';
                // Si se marca cualquier institución, desmarca "No aplica"
                document.getElementById('chk-NoAplica').checked = false;
            } else {
                subpanel.classList.add('d-none');
                label.style.fontWeight = '';
                label.style.color = '';
            }
        });
    });

    // "No aplica" desmarca todas las instituciones
    document.getElementById('chk-NoAplica').addEventListener('change', function () {
        if (this.checked) {
            document.querySelectorAll('.chk-institucion').forEach(function (chk) {
                chk.checked = false;
                var bloque = chk.closest('.permiso-bloque');
                bloque.querySelector('.subpanel-permiso').classList.add('d-none');
                var label = bloque.querySelector('label');
                label.style.fontWeight = '';
                label.style.color = '';
            });
        }
    });

    // ===== EVIDENCIAS =====
    function mostrarNombresArchivos(input) {
        var nombres = Array.from(input.files).map(function (f) { return f.name; }).join(', ');
        document.getElementById('lblEvidencias').textContent = nombres || 'Ningún archivo seleccionado';
    }

    // ===== GUARDAR PROYECTO =====
    document.getElementById('btnGuardarProyecto').addEventListener('click', function () {
        var permisos = [];
        document.querySelectorAll('.chk-institucion:checked').forEach(function (chk) {
            var bloque = chk.closest('.permiso-bloque');
            var seleccionados = Array.from(
                bloque.querySelectorAll('.permiso-item:checked')
            ).map(function (o) {
                return o.value;
            });
            var otro = bloque.querySelector('.otro-especifique').value.trim();

            permisos.push({
                Institucion: chk.dataset.inst,
                PermisosSeleccionados: seleccionados,
                OtroEspecifique: otro
            });
        });

        var formData = new FormData();

        var archivos = document.getElementById('inputEvidencias').files;
        
        formData.append('TipoProyecto', document.getElementById('TipoProyecto').value);
        formData.append('ProyectoID', document.getElementById('ProyectoID').value.trim());
        formData.append('NombreProyecto', document.getElementById('NombreProyecto').value.trim());
        formData.append('DescripcionObjetivo', document.getElementById('DescripcionObjetivo').value.trim());
        formData.append('InstitucionEmpresa', document.getElementById('InstitucionEmpresa').value.trim());
        formData.append('TipoInstitucion', document.getElementById('TipoInstitucionProy').value);
        formData.append('Financiamiento', document.getElementById('Financiamiento').value);
        formData.append('Responsable', document.getElementById('Responsable').value.trim());
        formData.append('FechaInicio', document.getElementById('FechaInicio').value);
        formData.append('FechaFin', document.getElementById('FechaFin').value);
        formData.append('EstadoActual', document.getElementById('EstadoActual').value);
        formData.append('Avance', parseInt(document.getElementById('Avance').value) || 0);
        formData.append(
            'EntidadFederativa',
            document.getElementById('EntidadFederativa')
                .options[document.getElementById('EntidadFederativa').selectedIndex]
                .text
        );
        formData.append('Municipio', document.getElementById('Municipio').value.trim());
        formData.append('Localidad', document.getElementById('Localidad').value.trim());
        formData.append('NotasFinales', document.getElementById('NotasFinales').value.trim());
        for (var i = 0; i < archivos.length; i++) {
            formData.append('Archivos', archivos[i]);
        }
        formData.append(
            'PermisosJson',
            JSON.stringify(permisos)
        );

        // Spinner
        document.getElementById('txtGuardar').textContent = 'Guardando...';
        document.getElementById('spnGuardar').classList.remove('d-none');
        document.getElementById('btnGuardarProyecto').disabled = true;

        fetch('/SiliMx/GuardarProyecto', {
            method: 'POST',
            body: formData
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            document.getElementById('txtGuardar').textContent = 'Guardar';
            document.getElementById('spnGuardar').classList.add('d-none');
            document.getElementById('btnGuardarProyecto').disabled = false;

            if (data.success) {
                document.getElementById('idProyectoGenerado').textContent = data.idVisible;
                new bootstrap.Modal(document.getElementById('modalProyectoGuardado')).show();
            } else {
                alert('Ocurrió un error al guardar el proyecto.');
            }
        })
        .catch(function () {
            document.getElementById('txtGuardar').textContent = 'Guardar';
            document.getElementById('spnGuardar').classList.add('d-none');
            document.getElementById('btnGuardarProyecto').disabled = false;
            alert('Error de conexión. Intenta de nuevo.');
        });
    });

    function resetearWizard() {
        // Limpiar todos los campos
        document.querySelectorAll('#wizardRegistro input, #wizardRegistro select, #wizardRegistro textarea')
            .forEach(function (el) { el.value = ''; });
        document.querySelectorAll('.chk-institucion').forEach(function (chk) {
            chk.checked = false;
            chk.closest('.permiso-bloque').querySelector('.subpanel-permiso').classList.add('d-none');
        });
        document.getElementById('chk-NoAplica').checked = false;
        document.getElementById('lblEvidencias').textContent = 'Ningún archivo seleccionado';
        irAPaso(1);
    }

    document
    .getElementById('EntidadFederativa')
    .addEventListener('change', function () {

        cargarMunicipios(this.value);

    });

    document
    .getElementById('act-EntidadFederativa')
    .addEventListener('change', function () {

        cargarMunicipiosAct(this.value);

    });

    function cargarMunicipios(estadoId) {

        const municipioSelect =
            document.getElementById('Municipio');

        municipioSelect.innerHTML =
            '<option value="">Cargando...</option>';

        municipioSelect.disabled = true;

        if (!estadoId) {

            municipioSelect.innerHTML =
                '<option value="">Seleccione un municipio...</option>';

            return;
        }

        fetch(`/SiliMx/ObtenerMunicipiosPorEstado?estadoId=${estadoId}`)

            .then(response => response.json())

            .then(data => {

                municipioSelect.innerHTML =
                    '<option value="">Seleccione un municipio...</option>';

                data.forEach(m => {
                    const option = document.createElement("option");
                    option.value = m.municipio_Nombre; // ✅ Guarda el nombre
                    option.text = m.municipio_Nombre;
                    municipioSelect.appendChild(option);
                });

                municipioSelect.disabled = false;
            })

            .catch(function () {

                municipioSelect.innerHTML =
                    '<option value="">Error al cargar municipios</option>';

            });
    }

    function cargarMunicipiosAct(estadoId) {

        const municipioSelect =
            document.getElementById('act-Municipio');

        municipioSelect.innerHTML =
            '<option value="">Cargando...</option>';

        municipioSelect.disabled = true;

        if (!estadoId) {

            municipioSelect.innerHTML =
                '<option value="">Seleccione un municipio...</option>';

            return;
        }

        fetch(`/SiliMx/ObtenerMunicipiosPorEstado?estadoId=${estadoId}`)

            .then(response => response.json())

            .then(data => {

                municipioSelect.innerHTML =
                    '<option value="">Seleccione un municipio...</option>';

                data.forEach(m => {
                    const option = document.createElement("option");
                    option.value = m.municipio_Nombre; // ✅ Guarda el nombre
                    option.text = m.municipio_Nombre;
                    municipioSelect.appendChild(option);
                });

                municipioSelect.disabled = false;
            })

            .catch(function () {

                municipioSelect.innerHTML =
                    '<option value="">Error al cargar municipios</option>';

            });
    }

    // Cargar proyectos en el selector al abrir el acordeón
    document.getElementById('panelActualizar').addEventListener('show.bs.collapse', function () {
        cargarSelectorProyectos();
    });

    function cargarSelectorProyectos() {
        fetch('/SiliMx/ObtenerSelectorProyectos')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var sel = document.getElementById('selectProyectoActualizar');
                sel.innerHTML = '<option value="">Formato: lista — usar "Catálogo de Proyectos"</option>';
                data.forEach(function (p) {
                    var opt = document.createElement('option');
                    opt.value = p.idProyecto;
                    opt.textContent = p.idVisible + ' — ' + p.nombreProyecto;
                    sel.appendChild(opt);
                });
            })
            .catch(function () { console.error('Error al cargar proyectos.'); });
    }

    // Habilitar botones al seleccionar proyecto
    document.getElementById('selectProyectoActualizar').addEventListener('change', function () {
        var tieneValor = !!this.value;
        document.getElementById('btnActualizar').disabled = !tieneValor;
        document.getElementById('btnSolicitar').disabled = !tieneValor;
        // Ocultar wizard si cambia la selección
        document.getElementById('wizardActualizar').classList.add('d-none');
        document.getElementById('selectorActualizar').querySelector('.row').classList.remove('d-none');
    });

    // Botón Actualizar: carga datos y abre wizard
    document.getElementById('btnActualizar').addEventListener('click', function () {
        var idProyecto = document.getElementById('selectProyectoActualizar').value;
        if (!idProyecto) return;

        fetch('/SiliMx/ObtenerProyectoCompleto?idProyecto=' + idProyecto)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                var p = data.proyecto;

                // Prellenar campos solo lectura
                document.getElementById('act-TipoProyecto').value = p.tipoProyecto || '';
                document.getElementById('act-IdVisible').value = 'A.' + (p.idVisible || '');
                document.getElementById('act-NombreProyecto').value = p.nombreProyecto || '';
                document.getElementById('act-DescripcionObjetivo').value = p.descripcionObjetivo || '';
                document.getElementById('act-InstitucionEmpresa').value = p.institucionEmpresa || '';
                document.getElementById('act-TipoInstitucion').value = p.tipoInstitucion || '';
                document.getElementById('act-Financiamiento').value = p.financiamiento || '';
                document.getElementById('act-Responsable').value = p.responsable || '';
                document.getElementById('act-FechaInicio').value = p.fechaInicio
                    ? p.fechaInicio.substring(0, 10) : '';

                // Prellenar editables
                document.getElementById('act-FechaFin').value = p.fechaFin
                    ? p.fechaFin.substring(0, 10) : '';
                document.getElementById('act-EstadoActual').value = p.estadoActual || '';
                document.getElementById('act-Avance').value = p.avance || 0;
                document.getElementById('act-EntidadFederativa').options[document.getElementById('act-EntidadFederativa').selectedIndex]
                .text = p.entidadFederativa || '';
                document.getElementById('act-Municipio').options[document.getElementById('act-Municipio').selectedIndex]
                .text = p.municipio || '';
                document.getElementById('act-Localidad').value = p.localidad || '';

                // Prellenar permisos
                if (data.permisos && data.permisos.length > 0) {
                    data.permisos.forEach(function (perm) {
                        var chk = document.getElementById('act-chk-' + perm.institucion);
                        if (chk) {
                            chk.checked = true;
                            var bloque = chk.closest('.permiso-bloque-act');
                            bloque.querySelector('.subpanel-act').classList.remove('d-none');

                            var valores = (perm.permisosSeleccionados || '').split('|');

                            bloque.querySelectorAll('.permiso-item-act').forEach(function (chkPermiso) {

                                chkPermiso.checked = valores.includes(chkPermiso.value);

                            });

                            bloque.querySelector('.otro-esp-act').value =
                                perm.otroEspecifique || '';
                        }
                    });
                }

                // Guardar el ID de proyecto seleccionado para el POST
                document.getElementById('wizardActualizar').dataset.idProyecto = idProyecto;

                // Mostrar wizard, ir al paso 1
                document.getElementById('wizardActualizar').classList.remove('d-none');
                irAPasoAct(1);
            })
            .catch(function () { alert('Error al cargar el proyecto.'); });
    });

    // Wizard de actualización: navegación entre pasos
    function irAPasoAct(numero) {
        document.querySelectorAll('.act-wizard-paso').forEach(function (el) {
            el.classList.add('d-none');
        });
        document.getElementById('actPaso' + numero).classList.remove('d-none');

        for (var i = 1; i <= 3; i++) {
            var tab = document.getElementById('act-tab-' + i);
            if (i === numero) {
                tab.style.backgroundColor = '#1b4332';
                tab.style.color = 'white';
            } else if (i < numero) {
                tab.style.backgroundColor = '#c9a86a';
                tab.style.color = 'white';
            } else {
                tab.style.backgroundColor = '#e0e0e0';
                tab.style.color = '#666';
            }
        }
    }

    // Permisos del wizard de actualización
    document.querySelectorAll('.chk-inst-act').forEach(function (chk) {
        chk.addEventListener('change', function () {
            var bloque = this.closest('.permiso-bloque-act');
            var subpanel = bloque.querySelector('.subpanel-act');
            if (this.checked) {
                subpanel.classList.remove('d-none');
                document.getElementById('act-chk-NoAplica').checked = false;
            } else {
                subpanel.classList.add('d-none');
            }
        });
    });

    document.getElementById('act-chk-NoAplica').addEventListener('change', function () {
        if (this.checked) {
            document.querySelectorAll('.chk-inst-act').forEach(function (chk) {
                chk.checked = false;
                chk.closest('.permiso-bloque-act')
                .querySelector('.subpanel-act').classList.add('d-none');
            });
        }
    });

    function mostrarNombresAct(input) {
        var nombres = Array.from(input.files).map(function (f) { return f.name; }).join(', ');
        document.getElementById('act-lblEvidencias').textContent =
            nombres || 'Ningún archivo seleccionado';
    }

    // Guardar actualización
    document.getElementById('btnGuardarActualizacion').addEventListener('click', function () {
        var idProyecto = parseInt(document.getElementById('wizardActualizar').dataset.idProyecto);

        var permisosAct = [];
        document.querySelectorAll('.chk-inst-act:checked').forEach(function (chk) {
            var bloque = chk.closest('.permiso-bloque-act');
            var seleccionados = Array.from(
                bloque.querySelectorAll('.permiso-item-act:checked')
            ).map(function (o) {
                return o.value;
            });
            var otro = bloque.querySelector('.otro-esp-act').value.trim();

            permisosAct.push({
                Institucion: chk.dataset.inst,
                PermisosSeleccionados: seleccionados,
                OtroEspecifique: otro
            });
        });

        var formData = new FormData();

        formData.append("IdProyecto", idProyecto);
        formData.append("TipoProyecto", document.getElementById('act-TipoProyecto').value);
        formData.append("ProyectoID", document.getElementById('act-IdVisible').value);
        formData.append("NombreProyecto", document.getElementById('act-NombreProyecto').value);
        formData.append("DescripcionObjetivo", document.getElementById('act-DescripcionObjetivo').value);
        formData.append("InstitucionEmpresa", document.getElementById('act-InstitucionEmpresa').value);
        formData.append("TipoInstitucion", document.getElementById('act-TipoInstitucion').value);
        formData.append("Financiamiento", document.getElementById('act-Financiamiento').value);
        formData.append("Responsable", document.getElementById('act-Responsable').value);
        formData.append("FechaInicio", document.getElementById('act-FechaInicio').value);
        formData.append("FechaFin", document.getElementById('act-FechaFin').value);
        formData.append("EstadoActual", document.getElementById('act-EstadoActual').value);
        formData.append("Avance", parseInt(document.getElementById('act-Avance').value) || 0);
        formData.append(
            'EntidadFederativa',
            document.getElementById('act-EntidadFederativa')
                .options[document.getElementById('act-EntidadFederativa').selectedIndex]
                .text
        );
        formData.append(
            'Municipio',
            document.getElementById('act-Municipio')
                .options[document.getElementById('act-Municipio').selectedIndex]
                .text
        );
        formData.append("Localidad", document.getElementById('act-Localidad').value.trim());
        formData.append("ResumenAvances", document.getElementById('act-ResumenAvances').value.trim());
        formData.append("NotasFinales", document.getElementById('act-NotasFinales').value.trim());
        for (const archivo of document.getElementById("act-inputEvidencias").files) {
            formData.append("Archivos", archivo);
        }

        formData.append(
            "PermisosJson",
            JSON.stringify(permisosAct)
        );

        document.getElementById('txtGuardarAct').textContent = 'Guardando...';
        document.getElementById('spnGuardarAct').classList.remove('d-none');
        document.getElementById('btnGuardarActualizacion').disabled = true;

        fetch('/SiliMx/GuardarActualizacion', {
            method: 'POST',
            body: formData
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            document.getElementById('txtGuardarAct').textContent = 'Guardar';
            document.getElementById('spnGuardarAct').classList.add('d-none');
            document.getElementById('btnGuardarActualizacion').disabled = false;

            if (data.success) {
                document.getElementById('idProyectoGenerado').textContent = data.idVisible;
                new bootstrap.Modal(document.getElementById('modalProyectoGuardado')).show();
                // Reutilizamos el mismo modal de confirmación del wizard de registro
            } else {
                alert('Ocurrió un error al guardar la actualización.');
            }
        })
        .catch(function () {
            document.getElementById('txtGuardarAct').textContent = 'Guardar';
            document.getElementById('spnGuardarAct').classList.add('d-none');
            document.getElementById('btnGuardarActualizacion').disabled = false;
            alert('Error de conexión. Intenta de nuevo.');
        });
    });
</script>
}