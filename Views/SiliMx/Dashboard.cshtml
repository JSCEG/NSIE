                                                            Cédula de Operación Anual (COA)
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Programa de Restauración, Cierre y Post-Cierre de Minas">
                                                        <label class="form-check-label">
                                                            Programa de Restauración, Cierre y Post-Cierre de Minas
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold">Otro (especifique)</label>
                                                <input type="text" class="form-control otro-especifique" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- CONAGUA -->
                                <div class="permiso-bloque mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="checkbox" class="chk-institucion"
                                               style="width:24px;height:24px;"
                                               data-inst="CONAGUA" id="chk-CONAGUA" />
                                        <label for="chk-CONAGUA" class="mb-0" id="lbl-CONAGUA">
