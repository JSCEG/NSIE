@* Views/SiliMx/Dashboard.cshtml *@
@model NSIE.Models.SilimxRegistroViewModel
@using NSIE.Models
@using Newtonsoft.Json
@{
    ViewData["Title"] = "SILiMx - Pantalla de Inicio";
    bool esDirectivo = ViewBag.EsDirectivo ?? false;

    var header = new HeaderViewModel
    {
        Title = "SILiMx - Pantalla de Inicio",
        IconPath = "siil.png",
        Description = "Plataforma de Inteligencia y Catálogo Nacional de Muestreo (SNIEn)",
        Section = "SILiMx",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "SIIL",
            description = "Registro y consultorio de información de litio",
            functionality = "Registro, consultoría y análisis de muestras y pronósticos",
            stage = "Operación",
            roles = new[] {
                new { icon = "flask", text = "Registro: captura de muestras" },
                new { icon = "map", text = "Consultorio: pronósticos y mapas" }
            }
        })
    };
}

<div class="container-fluid p-4">

    @await Html.PartialAsync("_ViewHeader", header)

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* {{-- Presentación del sistema --}} *@
    <div class="card border-0 shadow-sm mb-4" style="border-radius:10px; border: 1px solid #c9a86a !important;">
        <div class="card-body p-4">
            <h2 class="text-center fw-bold mb-3">
                <span class="fst-italic">S</span>istema de
                <span class="fst-italic">I</span>nteligencia del
                <span class="fst-italic">L</span>itio
                <span class="fst-italic">M</span>exicano
                (<strong>SIL<span class="fst-italic">i</span>Mx</strong>)
            </h2>
            <hr style="border-color:#c9a86a;">
            <p style="text-align:justify;">
                El Sistema de Inteligencia del Litio Mexicano (<strong>SILiMx</strong>) es una plataforma informática
                desarrollada por la Secretaría de Ciencia Humanidades Tecnología e Innovación (<strong>SECIHTI</strong>)
                y <strong>LitioMx</strong>, en coordinación con la Secretaría de Energía (<strong>SENER</strong>), como
                un componente especializado del Sistema Nacional de Información Energética (SNIEn) para mapear, articular
                y fortalecer las capacidades científicas, tecnológicas e industriales del país en torno a la cadena de
                valor del litio.
            </p>
            <p style="text-align:justify;">
                La gestión, resguardo y análisis de la información geocientífica, técnica y operativa relacionada con el
                litio en México servirá como base para impulsar alianzas estratégicas, orientar políticas públicas de
                financiamiento y acelerar la soberanía tecnológica de México en materia de transición energética.
            </p>
            <p class="text-center fst-italic" style="color:#1b4332; font-size:0.9rem;">
                ¡Tu contribución para el registro es muy valiosa para construir juntos el inventario
                de actividades en la cadena de valor del litio más completo de México!
            </p>
        </div>
    </div>

    @* {{-- Acordeón principal --}} *@
    <div class="accordion mb-4" id="acordeonSiliMx">

        @* {{-- 1. Registre su Proyecto --}} *@
        <div class="accordion-item border mb-3" style="border-color:#c9a86a !important; border-radius:8px; overflow:hidden;">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fst-italic"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#panelRegistro"
                        style="background-color:#f8f8f8; color:#555; font-size:1rem;">
                    Registre su Proyecto
                </button>
            </h2>
            <div id="panelRegistro" class="accordion-collapse collapse" data-bs-parent="#acordeonSiliMx">
                <div class="accordion-body p-4">

                    @* {{-- Pasos del wizard --}} *@
                    <div id="wizardRegistro">

                        @* {{-- Indicador de pasos --}} *@
                        <div class="d-flex gap-2 mb-4" id="indicadorPasos">
                            <span id="paso-tab-1" class="badge px-3 py-2"
                                  style="background-color:#1b4332; color:white; border-radius:20px; cursor:pointer;"
                                  onclick="irAPaso(1)">1. Proyecto</span>
                            <span id="paso-tab-2" class="badge px-3 py-2"
                                  style="background-color:#e0e0e0; color:#666; border-radius:20px; cursor:default;">
                                2. Permisos y autorizaciones</span>
                            <span id="paso-tab-3" class="badge px-3 py-2"
                                  style="background-color:#e0e0e0; color:#666; border-radius:20px; cursor:default;">
                                3. Notas finales y Evidencias</span>
                        </div>

                        @* {{-- PASO 1: Proyecto --}} *@
                        <div id="paso1" class="wizard-paso">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Tipo de Proyecto</label>
                                    <select id="TipoProyecto" class="form-select">
                                        <option value="">-- Selecciona --</option>
                                        <option value="EE">Exploración y Explotación (EE)</option>
                                        <option value="BE">Beneficio (BE)</option>
                                        <option value="MA">Manufactura (MA)</option>
                                        <option value="EC">Economía Circular (EC)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Proyecto (ID)
                                        <small class="text-muted fw-normal">— Solo letras A-Z, números y puntos</small>
                                    </label>
                                    <input type="text" id="ProyectoID" class="form-control"
                                           placeholder="Sin espacios" pattern="[A-Za-z0-9.]+" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Nombre del proyecto</label>
                                    <input type="text" id="NombreProyecto" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Descripción del proyecto / Objetivo</label>
                                    <input type="text" id="DescripcionObjetivo" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Institución / Empresa</label>
                                    <input type="text" id="InstitucionEmpresa" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Tipo de Institución</label>
                                    <select id="TipoInstitucionProy" class="form-select">
                                        <option value="">-- Selecciona --</option>
                                        <option>Pública (Federal)</option>
                                        <option>Pública (Estatal)</option>
                                        <option>Pública (Municipal)</option>
                                        <option>Privada</option>
                                        <option>Consorcio (Público-Privado)</option>
                                        <option>Investigador independiente / sociedad civil</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Financiamiento</label>
                                    <select id="Financiamiento" class="form-select">
                                        <option value="">-- Selecciona --</option>
                                        <option>Fondos públicos</option>
                                        <option>Capital privado</option>
                                        <option>Financiamiento mixto (Pública-Privada)</option>
                                        <option>Recursos propios / sin fondos</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Responsable</label>
                                    <input type="text" id="Responsable" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Fecha inicio</label>
                                    <input type="date" id="FechaInicio" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Fecha fin</label>
                                    <input type="date" id="FechaFin" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Estado actual</label>
                                    <select id="EstadoActual" class="form-select">
                                        <option value="">-- Selecciona --</option>
                                        <option>En planeación</option>
                                        <option>En progreso</option>
                                        <option>Concluido</option>
                                        <option>Suspendido</option>
                                        <option>Terminación anticipada</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Avance (%)</label>
                                    <input type="number" id="Avance" class="form-control"
                                           min="0" max="100" placeholder="0 a 100" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Entidad Federativa
                                    </label>

                                    <select id="EntidadFederativa" class="form-select">
                                        <option value="">Seleccione un estado...</option>

                                        @foreach (var estado in ViewBag.Estados)
                                        {
                                            <option value="@estado.EF_ID">
                                                @estado.EF_Nombre
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Municipio
                                    </label>

                                    <select id="Municipio" class="form-select" disabled>
                                        <option value="">
                                            Seleccione un municipio...
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Localidad</label>
                                    <input type="text" id="Localidad" class="form-control" />
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-4">
                                <button class="btn px-4 text-white" style="background-color:#c9a86a;"
                                        onclick="irAPaso(2)">Siguiente →</button>
                            </div>
                        </div>

                        @* {{-- PASO 2: Permisos y autorizaciones --}} *@
