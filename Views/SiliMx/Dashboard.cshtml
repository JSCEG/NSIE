                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-semibold">Permisos y autorizaciones</label>
                                                <div class="permisos-lista">

                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Informe Preventivo">
                                                        <label class="form-check-label">
                                                            Informe Preventivo
                                                        </label>
                                                    </div>

                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Manifestación de Impacto Ambiental (MIA)">
                                                        <label class="form-check-label">
                                                            Manifestación de Impacto Ambiental (MIA)
                                                        </label>
                                                    </div>

                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Cambio de Uso de Suelo en Terrenos Forestales (CUSTF)">
                                                        <label class="form-check-label">
                                                            Cambio de Uso de Suelo en Terrenos Forestales (CUSTF)
                                                        </label>
                                                    </div>
                                                
                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Estudio de Riesgo Ambiental (ERA)">
                                                        <label class="form-check-label">
                                                            Estudio de Riesgo Ambiental (ERA)
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Programa para la Prevención de Accidentes (PPA)">
                                                        <label class="form-check-label">
                                                            Programa para la Prevención de Accidentes (PPA)
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
                                                            type="checkbox"
                                                            value="Licencia Ambiental Única (LAU)">
                                                        <label class="form-check-label">
                                                            Licencia Ambiental Única (LAU)
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input permiso-item"
