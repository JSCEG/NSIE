                                               style="width:24px;height:24px;"
                                               data-inst="SE" id="chk-SE" />
                                        <label for="chk-SE" class="mb-0" id="lbl-SE">
                                            SE - Secretaría de Economía
                                        </label>
                                    </div>
                                    <div class="subpanel-permiso d-none mt-2 p-3"
                                         style="border:2px solid #c9a86a; border-radius:6px;">
                                        <div class="row g-3">
