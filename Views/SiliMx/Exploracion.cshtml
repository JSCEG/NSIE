@* Views/SiliMx/Exploracion.cshtml *@
@using NSIE.Models
@using Newtonsoft.Json
@model NSIE.Models.SilimxRegistroViewModel
@{
    ViewData["Title"] = "SILiMx - I.1 Exploración";

    var header = new HeaderViewModel
    {
        Title = "SILiMx - I.1 Exploración",
        IconPath = "siil.png",
        Description = "Plataforma de Inteligencia y Catálogo Nacional de Muestreo (SNIEn)",
        Section = "SILiMx",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "SIIL",
            description = "Registro y consultorio de información de litio",
            functionality = "Registro, consultoría y análisis de muestras y pronósticos",
            stage = "Operación",
            roles = new[] {
                new { icon = "flask", text = "Registro: captura de muestras" },
                new { icon = "map", text = "Consultorio: pronósticos y mapas" }
            }
        })
    };
}

<style>
    .flecha-boton {
        position: relative;
        display: inline-block;
        width: 100%;
        padding: 14px 10px;
        background-color: #621132;
        color: white;
        font-weight: bold;
        font-size: 1rem;
        letter-spacing: 1.5px;
        text-align: center;
        border: none;
        cursor: pointer;
        clip-path: polygon(0% 0%, 88% 0%, 100% 50%, 88% 100%, 0% 100%);
        text-decoration: none;
        transition: background-color 0.2s;
    }

    .flecha-boton:hover {
        background-color: #8a1a48;
        color: white;
    }

    .col-subseccion {
        border-right: 1px solid #dee2e6;
        padding: 0 20px;
    }

    .col-subseccion:last-child {
        border-right: none;
    }

    .nota-subseccion {
        font-size: 0.72rem;
        color: #aaa;
        text-align: center;
        min-height: 80px;
        line-height: 1.4;
    }

    .requiere-badge {
        color: #621132;
        font-weight: 600;
        font-size: 0.72rem;
    }

    .catalogo-link {
        font-size: 0.78rem;
        color: #555;
        text-decoration: underline;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
    }

    .catalogo-link:hover {
        color: #1b4332;
    }
</style>

<div class="container-fluid p-4">

    @await Html.PartialAsync("_ViewHeader", header)

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* {{-- Breadcrumb --}} *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size:0.85rem;">
            <li class="breadcrumb-item">
                <a href="@Url.Action("ExploracionExplotacion", "SiliMx")"
                   style="color:#1b4332; text-decoration:none;">
                    I. Exploración y Explotación
                </a>
            </li>
            <li class="breadcrumb-item active fw-semibold" style="color:#555;">
                I.1 Exploración
            </li>
        </ol>
    </nav>

    @* {{-- Bloque descriptivo --}} *@
    <div class="card border-0 shadow-sm mb-4"
         style="border-radius:10px; border:1px solid #ddd !important;">
        <div class="card-body p-4 p-md-5">

            <h2 class="text-center fw-bold mb-3"
                style="font-variant:small-caps; letter-spacing:1px;">
                Exploración
            </h2>

            <hr style="border-color:#c9a86a;">

            <p style="text-align:justify; color:#c9a86a; font-style:italic; font-size:0.92rem;">
                "Este formulario registra las muestras de litio recolectadas en campo según origen
                —salmueras petroleras o geotérmicas, o arcillas superficiales o profundas—.
                Los datos aquí capturados permitirán conocer la distribución y características del
                litio en el territorio nacional, así como sondear los esfuerzos de muestreo a lo
                largo del país."
            </p>

            <p class="text-center fst-italic mt-3"
               style="color:#1b4332; font-size:0.85rem;">
                "Tu contribución para el registro es muy valiosa para construir juntos el inventario
                de muestras para exploración de litio más completo de México".
            </p>

        </div>
    </div>

    @* {{-- Acordeón: Seleccione subsección --}} *@
    <div class="accordion mb-4" id="acordeonExploracion">
        <div class="accordion-item border"
             style="border-color:#c9a86a !important; border-radius:8px; overflow:hidden;">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fst-italic"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#panelSubseccion"
                        style="background-color:#f8f8f8; color:#555; font-size:1rem;">
                    Seleccione subsección
                </button>
            </h2>
            <div id="panelSubseccion" class="accordion-collapse collapse"
                 data-bs-parent="#acordeonExploracion">
                <div class="accordion-body p-4">

                    <div class="row g-0">

                        @* {{-- COLUMNA 1: BARRENOS --}} *@
                        <div class="col-md-4 col-subseccion">
                            <div class="nota-subseccion mb-3">
                                <span class="text-muted" style="font-size:0.7rem;">
                                    Omita este paso si su muestra no proviene de
                                    núcleos obtenidos mediante barrenos.
                                </span><br>
                                <span class="requiere-badge">Requiere ProyectoID</span>
                                <div class="mt-2 text-start px-1" style="font-size:0.72rem; color:#666;">
                                    1. Si su muestra proviene de arcillas profundas, registre
                                    aquí el barreno de procedencia.
                                </div>
                            </div>

                            <div class="d-flex justify-content-center mb-3">
                                <a href="@Url.Action("Barrenos", "SiliMx")"
                                   class="flecha-boton"
                                   style="max-width:200px;">
                                    BARRENOS
                                </a>
                            </div>

                            <div class="text-center text-muted mb-2"
                                 style="font-size:0.72rem; font-style:italic;">
                                - Genera BarrenoID
                            </div>

                            <div class="text-center">
                                <a href="@Url.Action("CatalogoBarrenos", "SiliMx")"
                                   class="catalogo-link">
                                    Catálogo de Barrenos
                                </a>
                            </div>
                        </div>

                        @* {{-- COLUMNA 2: MUESTRAS --}} *@
                        <div class="col-md-4 col-subseccion">
                            <div class="nota-subseccion mb-3">
                                <span class="requiere-badge">Requiere ProyectoID</span><br>
                                <span class="text-muted" style="font-size:0.7rem;">
                                    Requiere BarrenoID, si su muestra es una arcilla profunda
                                </span>
                                <div class="mt-2 text-start px-1" style="font-size:0.72rem; color:#666;">
                                    2. Registre aquí las muestras tomadas durante el proyecto.
                                </div>
                            </div>

                            <div class="d-flex justify-content-center mb-3">
                                <a href="@Url.Action("Muestras", "SiliMx")"
                                   class="flecha-boton"
                                   style="max-width:200px;">
                                    MUESTRAS
                                </a>
                            </div>

                            <div class="text-center text-muted mb-2"
                                 style="font-size:0.72rem; font-style:italic;">
                                - Genera MuestraID
                            </div>

                            <div class="text-center">
                                <a href="@Url.Action("CatalogoMuestras", "SiliMx")"
                                   class="catalogo-link">
                                    Catálogo de Muestras
                                </a>
                            </div>
                        </div>

                        @* {{-- COLUMNA 3: ANÁLISIS --}} *@
                        <div class="col-md-4 col-subseccion">
                            <div class="nota-subseccion mb-3">
                                <span class="requiere-badge">Requiere ProyectoID</span><br>
                                <span class="requiere-badge">Requiere MuestraID</span>
                                <div class="mt-2 text-start px-1" style="font-size:0.72rem; color:#666;">
                                    3. Registre aquí los análisis que llevó a cabo de las muestras.
                                </div>
                            </div>

                            <div class="d-flex justify-content-center mb-3">
                                <a href="@Url.Action("Analisis", "SiliMx")"
                                   class="flecha-boton"
                                   style="max-width:200px;">
                                    ANÁLISIS
                                </a>
                            </div>

                            <div class="text-center text-muted mb-2"
                                 style="font-size:0.72rem; font-style:italic;">
                                - Genera AnálisisID
                            </div>

                            <div class="text-center">
                                <a href="@Url.Action("CatalogoAnalisis", "SiliMx")"
                                   class="catalogo-link">
                                    Catálogo de Análisis
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    @* {{-- Botones inferiores --}} *@
    <div class="d-flex justify-content-between align-items-center mt-2">
        <a href="@Url.Action("Dashboard", "SiliMx")"
           class="btn px-4"
           style="background-color:#e8e8e8; color:#333; border:1px solid #ccc; font-weight:500;">
            ← Volver al Inicio
        </a>
        <a href="@Url.Action("ExploracionExplotacion", "SiliMx")"
           class="btn px-4"
           style="background-color:#e8e8e8; color:#333; border:1px solid #ccc; font-weight:500;">
            Volver
        </a>
    </div>

</div>