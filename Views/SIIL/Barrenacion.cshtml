        function generarBarrenoID() {

            const proyecto = proyectoVB;
            const estado = estadoVB.trim();
            const municipio = municipioVB.trim();

            if (!proyecto || !estado || !municipio) {
                alert("Faltan datos para generar el ID");
                return;
            }

            const zona = generarZona(estado, municipio);

            console.log("Generando ID para:", { proyecto, estado, municipio, zona });

            fetch(`/SIIL/ObtenerSiguienteConsecutivo?proyecto=${proyecto}&zona=${zona}`)
                .then(res => res.json())
                .then(data => {

                    const consecutivo = data.consecutivo;

                    const id = `${proyecto}-${zona}-BRN-${consecutivo}`;

                    const input = document.getElementById("BarrenoID");
                    input.value = id;

                    input.setAttribute("readonly", true);

                    generarCajaID();
                });
        }

        function generarZona(estado, municipio) {

            const estado3 = estado.substring(0, 3).toUpperCase();
            const municipio5 = municipio.substring(0, 5).toUpperCase();

            return estado3 + municipio5;
        }

        function generarCajaID() {

            const barrenoID = document.getElementById("BarrenoID").value;

            if (!barrenoID) {
                alert("Primero genera el BarrenoID");
                return;
            }

            fetch(`/SIIL/ObtenerSiguienteConsecutivoCaja?barrenoID=${encodeURIComponent(barrenoID)}`)
                .then(res => res.json())
                .then(data => {

                    if (!data.success) {
                        alert("Error al generar consecutivo");
                        return;
                    }

                    const consecutivo = data.consecutivo;

                    const cajaID = `${barrenoID}_C.${consecutivo}`;

                    const input = document.getElementById("CajaID");
                    input.value = cajaID;

                    input.setAttribute("readonly", true);
                });
        }

