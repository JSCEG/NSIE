@model NSIE.Models.BarrenacionViewModel
@using NSIE.Models
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Registro de Barrenación - Formulario 1";
    var pronosticos = ViewBag.PronosticosPozos as List<PronosticoPozo> ?? new List<PronosticoPozo>();
    var header = new HeaderViewModel
    {
        Title = "SIIL - Registro de Barrenación",
        IconPath = "siil.png",
        Description = "Formulario 1: Captura operativa de barrenación",
        Section = "SIIL",
        ModuleInfo = JsonConvert.SerializeObject(new
        {
            title = "Registro",
            description = "Captura y trazabilidad de barrenación",
            functionality = "Registro operativo de barrenación con ID único",
            stage = "Operación",
            roles = new[] {
                new { icon = "flask", text = "Operadores de Campo: Registro de barrenación" }
            }
        })
    };
}

<div class="container-fluid siil-form">
    @await Html.PartialAsync("_ViewHeader", header)

    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <!-- TÍTULO -->
                <div class="siil-title">
                    <div class="siil-title__icon">
                        <i class="bi bi-tools"></i>
                    </div>
                    <div>
                        <h2 class="mb-1">Registro de Barrenación</h2>
                        <div class="text-muted small">Formulario 1: Operación de Campo</div>
                    </div>
                </div>

                <div class="alert siil-alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Instrucción SNIEr:</strong>
                    Registre con precisión la información del punto de barrenación y del núcleo recuperado.
                </div>

                @using (Html.BeginForm("Barrenacion", "SIIL", FormMethod.Post, new { id="formBarrenacion", enctype="multipart/form-data"}))
                {
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- ================================= -->
                    <!-- 1 CONTEXTO DEL PUNTO DE BARRENACIÓN -->
                    <!-- ================================= -->

                    <div class="card siil-card mb-4">

                        <div class="card-header siil-card__header">
                            <h5 class="mb-0">Registro de Barrenación</h5>
                        </div>

                        <div class="card-body">

                            <!-- ===================== -->
                            <!-- IDENTIFICACIÓN -->
                            <!-- ===================== -->

                            <h6 class="text-primary mb-3">Identificación</h6>

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <label class="form-label">Barreno (ID) <span class="text-danger">*</span></label>
                                    <input asp-for="BarrenoID" class="form-control" required>
                                    <span asp-validation-for="BarrenoID" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Perforista <span class="text-danger">*</span></label>
                                    <input asp-for="Perforista" class="form-control" required>
                                    <span asp-validation-for="Perforista" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Responsable de perforación <span class="text-danger">*</span></label>
                                    <input asp-for="Responsable" class="form-control" required>
                                    <span asp-validation-for="Responsable" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Responsable de descripción del núcleo <span class="text-danger">*</span></label>
                                    <input asp-for="ResponsableNucleo" class="form-control" required>
                                    <span asp-validation-for="ResponsableNucleo" class="text-danger"></span>
                                </div>

                            </div>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- CONTEXTO -->
                            <!-- ===================== -->

                            <h6 class="text-primary mb-3">Contexto</h6>

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <label>Gravimetría *</label>
                                    <input asp-for="AnomaliaGravimetrica" type="number" step="0.01" class="form-control" placeholder="Valor en mGal" required>
                                    <span asp-validation-for="AnomaliaGravimetrica" class="text-danger"></span>
                                </div>

                                <div class="col-md-9">
                                    <label>Justificación principal <span class="text-danger">*</span></label>
                                    <textarea asp-for="Anomalia1" class="form-control" required></textarea>
                                    <span asp-validation-for="Anomalia1" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Justificación secundaria</label>
                                    <textarea asp-for="Anomalia2" class="form-control"></textarea>
                                </div>

                                <div class="col-md-6">
                                    <label>Justificación terciaria</label>
                                    <textarea asp-for="Anomalia3" class="form-control"></textarea>
                                </div>

                            </div>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- CONDICIONES -->
                            <!-- ===================== -->

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label>Accesibilidad <span class="text-danger">*</span></label>
                                    <select asp-for="Accesibilidad" class="form-select" required>
                                        <option value="">Seleccione...</option>
                                        <option>Buena</option>
                                        <option>Regular</option>
                                        <option>Mala</option>
                                        <option>Solo Helicóptero</option>
                                    </select>
                                    <span asp-validation-for="Accesibilidad" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Tipo de Terreno <span class="text-danger">*</span></label>
                                    <select asp-for="TipoTerreno" class="form-select" required>
                                        <option value="">Seleccione...</option>
                                        <option>Planicie (Valle o Cuenca)</option>
                                        <option>Lomerío suave</option>
                                        <option>Piedemonte</option>
                                        <option>Cañada / Arroyo</option>
                                        <option>Mesa / Meseta</option>
                                        <option>Sierra (Ladera)</option>
                                        <option>Banco de Material</option>
                                    </select>
                                    <span asp-validation-for="TipoTerreno" class="text-danger"></span>
                                </div>

                            </div>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- COORDENADAS -->
                            <!-- ===================== -->

                            <h6 class="text-primary mb-3">Ubicación</h6>

                            <div class="row g-3">

                                <div class="col-md-4">
                                    <label>Latitud (Y) <span class="text-danger">*</span></label>
                                    <input asp-for="Latitud" class="form-control" type="number" step="0.00001" required>
                                    <span asp-validation-for="Latitud" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label>Longitud (X) <span class="text-danger">*</span></label>
                                    <input asp-for="Longitud" class="form-control" type="number" step="0.00001" required>
                                    <span asp-validation-for="Longitud" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label>Altitud (Z) <span class="text-danger">*</span></label>
                                    <input asp-for="Altitud" class="form-control" type="number" step="0.01" required>
                                    <span asp-validation-for="Altitud" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Azimut <span class="text-danger">*</span></label>
                                    <input asp-for="Azimut" class="form-control" type="number" required>
                                    <span asp-validation-for="Azimut" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Inclinación <span class="text-danger">*</span></label>
                                    <input asp-for="Inclinacion" class="form-control" type="number" required>
                                    <span asp-validation-for="Inclinacion" class="text-danger"></span>
                                </div>

                            </div>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- PROGRAMA -->
                            <!-- ===================== -->

                            <div class="row g-3">

                                <div class="col-md-4">
                                    <label>Tipo de barrenación <span class="text-danger">*</span></label>
                                    <select asp-for="TipoBarrenacion" id="TipoBarrenacion" class="form-select" required>
                                        <option value="">Seleccione...</option>
                                        <option>Corte Diamante</option>
                                        <option>Circulación inversa</option>
                                        <option>Aire nucleo</option>
                                        <option>Sónica</option>
                                        <option>Helicoidal</option>
                                        <option value="OTRO">Otro:</option>
                                    </select>
                                    <input asp-for="TipoBarrenacionOtro" id="TipoBarrenacionOtro" class="form-control mt-2" style="display:none;" placeholder="Escriba otro tipo de barrenación">
                                </div>

                                <div class="col-md-4">
                                    <label>Fecha de inicio <span class="text-danger">*</span></label>
                                    <input asp-for="FechaInicio" type="date" class="form-control" required>
                                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label>Fecha de finalización <span class="text-danger">*</span></label>
                                    <input asp-for="FechaFinalizacion" type="date" class="form-control" required>
                                    <span asp-validation-for="FechaFinalizacion" class="text-danger"></span>
                                </div>

                            </div>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- NÚCLEO -->
                            <!-- ===================== -->

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <label>Longitud perforada <span class="text-danger">*</span></label>
                                    <input asp-for="LongitudPerforada" id="LongitudPerforada"  type="number" step="0.01" class="form-control" required>
                                    <span asp-validation-for="LongitudPerforada" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label>Longitud recuperada <span class="text-danger">*</span></label>
                                    <input asp-for="LongitudRecuperada" id="LongitudRecuperada" class="form-control" required>
                                    <span asp-validation-for="LongitudRecuperada" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label>TCR <span class="text-danger">*</span></label>
                                    <input asp-for="TCR" id="TCR" type="number" step="0.01" class="form-control" readonly required>
                                    <span asp-validation-for="TCR" class="text-danger"></span>
                                </div>

                                <div class="col-md-12">
                                    <label>TCR Notas</label>
                                    <textarea asp-for="TCRNotas" class="form-control"></textarea>
                                </div>

                                <div class="col-md-3">
                                    <label>Diámetro <span class="text-danger">*</span></label>
                                    <input asp-for="Diametro" class="form-control" type="number" required>
                                    <span asp-validation-for="Diametro" class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label>Número de cajas <span class="text-danger">*</span></label>
                                    <input asp-for="NumeroCajas" class="form-control" type="number" required>
                                    <span asp-validation-for="NumeroCajas" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Nombre de la primera caja <span class="text-danger">*</span></label>
                                    <input class="form-control" id="CajaID"  placeholder="SEFMP31-SONNOGAL-BRN-001_C.001" readonly>
                                    @* <span asp-validation-for="NombreCajas" class="text-danger"></span> *@
                                </div>

                                <div class="col-md-3" id="grupoRQD" style="display: none;">
                                    <label>RQD</label>
                                    <select asp-for="RQD" id="RQD" class="form-select">
                                        <option value="">Seleccione...</option>
                                        <option>90% - 100% (Excelente)</option>
                                        <option>75% - 90% (Bueno)</option>
                                        <option>50% - 75% (Regular)</option>
                                        <option>25% - 50% (Pobre)</option>
                                        <option>0% - 25% (Muy pobre)</option>
                                    </select>
                                </div>

                            </div>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- INTERVALOS -->
                            <!-- ===================== -->

                            <h6 class="text-primary mb-3">Intervalos</h6>

                            <!-- tu tabla aquí -->
                            <table class="table table-bordered" id="tablaIntervalos">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Desde (m)</th>
                                        <th>Hasta (m)</th>
                                        <th>¿Interés?</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Filas dinámicas -->
                                </tbody>
                            </table>

                            <button type="button" class="btn btn-primary" onclick="agregarFila()">
                                Agregar intervalo
                            </button>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- NOTAS -->
                            <!-- ===================== -->

                            <div>
                                <label>Notas finales <span class="text-danger">*</span></label>
                                <textarea asp-for="Observaciones" class="form-control"></textarea>
                            </div>

                            <hr class="my-4">

                            <!-- ===================== -->
                            <!-- ARCHIVOS -->
                            <!-- ===================== -->

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label>Archivo de Descripción del Núcleo <span class="text-danger">*</span></label>
                                    <input asp-for="ArchivoDescripcionNucleo" type="file" class="form-control" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv">
                                    <span asp-validation-for="ArchivoDescripcionNucleo" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label>Fotografías del núcleo <span class="text-danger">*</span></label>
                                    <input asp-for="FotografiasNucleo" type="file" class="form-control" multiple accept="image/jpeg,image/png,.jpg,.jpeg,.png">
                                    <span asp-validation-for="FotografiasNucleo" class="text-danger"></span>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- BOTONES -->

                    <div class="d-grid gap-2">

                        <button type="submit" class="btn btn-siil-primary btn-lg">
                            <i class="bi bi-save me-2"></i>
                            Guardar Registro de Barrenación
                        </button>

                        <a asp-action="CrearMuestra" class="btn btn-siil-secondary">
                            <i class="bi bi-x-circle me-2"></i>
                            Regresar
                        </a>

                    </div>

                }

            </div>
        </div>
    </div>
    <style>
        .form-label {
            font-weight: 600;
            color: #5b6472;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            font-size: 0.75rem;
        }

        .siil-form .form-control,
        .siil-form .form-select {
            border-radius: 14px;
            border: 1px solid #e6edf6;
            box-shadow: 0 1px 0 rgba(16, 24, 40, 0.02);
            padding: 0.7rem 0.9rem;
        }

        .siil-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .siil-title__icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: #e9f3ff;
            color: #2f80ed;
            display: grid;
            place-items: center;
            font-size: 1.1rem;
        }

        .siil-alert {
            background: #f4f8ff;
            border: 1px solid #e3ecff;
            color: #2b3b53;
            border-radius: 14px;
            padding: 0.85rem 1rem;
        }

        .siil-card {
            border-radius: 16px;
            border: 1px solid #ecf1f6;
            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
        }

        .siil-card__header {
            background: #f7f9fc;
            border-bottom: 1px solid #edf2f7;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            color: #2b3b53;
            font-weight: 600;
        }

        .siil-card__header--warning {
            background: #fff7e6;
            color: #8a5b00;
        }

        .siil-card__header--success {
            background: #ecfdf3;
            color: #1c7c54;
        }

        .siil-subpanel {
            background: #f7f9fc;
            border: 1px dashed #e0e7ff;
            border-radius: 14px;
            padding: 1rem;
        }

        .siil-id-preview {
            margin-top: 1.5rem;
            padding: 1rem;
            border-radius: 16px;
            background: #f2fceb;
            border: 1px solid #dff2c6;
        }

        .siil-id-preview__value {
            font-weight: 700;
            color: #62b400;
            letter-spacing: 0.04em;
        }

        .btn-siil-primary {
            background: #77c308;
            border-color: #77c308;
            color: #fff;
            border-radius: 14px;
            padding: 0.85rem 1rem;
        }

        .btn-siil-primary:hover {
            background: #66ad06;
            border-color: #66ad06;
            color: #fff;
        }

        .btn-siil-secondary {
            border-radius: 14px;
            border: 1px solid #e6edf6;
            color: #5b6472;
            background: #fff;
            padding: 0.85rem 1rem;
        }

        .btn-siil-secondary:hover {
            background: #f7f9fc;
        }

        .btn-lg {
            font-size: 1.05rem;
        }

        .font-monospace {
            letter-spacing: 0.05em;
        }

    </style>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        const proyectoVB = "@ViewBag.Proyecto";
        const estadoVB = "@ViewBag.Estado";
        const municipioVB = "@ViewBag.Municipio";

        document.addEventListener("DOMContentLoaded", function () {

            inicializarEventos();
            @* inicializarMapa(); *@

            const form = document.getElementById("formBarrenacion");

            document.getElementById("BarrenoID").addEventListener("input", generarCajaID);

            generarBarrenoID();
            inicializarIntervalos();

            if (form) {

                form.addEventListener("submit", function (e) {

                    @* e.preventDefault(); *@

                    debugIntervalos();

                    const validoForm = validarFormularioBarrenacion();
                    const validoIntervalos = validarIntervalosFinal();

                    if (!validoForm || !validoIntervalos) {
                        e.preventDefault();
                        return;
                    }

                    // 🔥 CHECKBOXES
                    document.querySelectorAll(".input-interes").forEach(chk => {

                        // eliminar hidden previos
                        const prev =
                            form.querySelectorAll(`input[type="hidden"][name="${chk.name}"]`);

                        prev.forEach(x => x.remove());

                        // si NO está marcado → mandar false
                        if (!chk.checked) {

                            const hidden = document.createElement("input");

                            hidden.type = "hidden";
                            hidden.name = chk.name;
                            hidden.value = "false";

                            form.appendChild(hidden);
                        }
                    });

                    const btn = form.querySelector("button[type='submit']");
                    btn.disabled = true;
                    btn.innerHTML = "Guardando...";
                });
            }
        });

        function debugIntervalos() {
           
            const form = document.getElementById("formBarrenacion");
            const formData = new FormData(form);

            console.clear();

            console.log("===== INTERVALOS =====");

            for (let pair of formData.entries()) {

                if (pair[0].startsWith("Intervalos")) {
                    console.log(pair[0], pair[1]);
                }
            }
        }

        function inicializarEventos(){

            const tipo = document.getElementById("TipoBarrenacion");
            const lat = document.getElementById("Latitud");
            const lon = document.getElementById("Longitud");
            const tcr = document.getElementById("TCR");
            const longitudP = document.getElementById("LongitudPerforada");
            const longitudR = document.getElementById("LongitudRecuperada");

            const inputOtro = document.getElementById("TipoBarrenacionOtro");

            if(longitudP && longitudR){
                longitudP.addEventListener("input", calcularTCR);
                longitudR.addEventListener("input", calcularTCR);
            }

            if(tipo){
                tipo.addEventListener("change", activarRQD);
            }

            if(lat && lon){
                lat.addEventListener("input", limpiarErrorCoordenadaBarrenacion);
                lon.addEventListener("input", limpiarErrorCoordenadaBarrenacion);
                lat.addEventListener("blur", validarCoordenadasBarrenacion);
                lon.addEventListener("blur", validarCoordenadasBarrenacion);
            }

            // 🔹 Lógica "Otro"
            if (tipo && inputOtro) {

                function toggleOtro() {

                    if (tipo.value === "OTRO") {
                        inputOtro.style.display = "block";
                    } else {
                        inputOtro.style.display = "none";
                        inputOtro.value = "";
                    }
                }

                toggleOtro();

                tipo.addEventListener("change", toggleOtro);
            }
        }

        function activarRQD(){

            const tipo = document.getElementById("TipoBarrenacion").value;
            const rqd = document.getElementById("RQD");
            const grupo = document.getElementById("grupoRQD");

            const inputOtro = document.getElementById("TipoBarrenacionOtro");

            // 🔹 Lógica RQD
            if(tipo === "Corte Diamante"){
                grupo.style.display = "block";
                rqd.disabled = false;
            } else {
                grupo.style.display = "none";
                rqd.value = "";
                rqd.disabled = true;
            }

            // 🔹 Lógica "Otro"
            if (tipo && inputOtro) {

                function toggleOtro() {

                    if (tipo.value === "OTRO") {
                        inputOtro.style.display = "block";
                    } else {
                        inputOtro.style.display = "none";
                        inputOtro.value = "";
                    }
                }

                toggleOtro();

                tipo.addEventListener("change", toggleOtro);
            }
        }

        @* document.querySelector("form").addEventListener("submit", function () {
    
            const select = document.getElementById("TipoBarrenacion");
            const inputOtro = document.getElementById("TipoBarrenacionOtro");

            console.log("Valor antes de submit:", select.value);

            if(select.value === "OTRO"){
                select.value = inputOtro.value; // 🔥 reemplaza el valor
            }
        }); *@

        function validarFormularioBarrenacion(){

            limpiarValidaciones();

            let valido = true;

            const lat = parseFloat(document.getElementById("Latitud").value);
            const lon = parseFloat(document.getElementById("Longitud").value);
            const alt = parseFloat(document.getElementById("Altitud").value);
            const azimut = parseInt(document.getElementById("Azimut").value);
            const inclinacion = parseInt(document.getElementById("Inclinacion").value);

            const fechaInicio = document.getElementById("FechaInicio").value;
            const fechaFin = document.getElementById("FechaFin").value;

            const longitudP = parseFloat(document.getElementById("LongitudPerforada").value);
            const longitudR = parseFloat(document.getElementById("LongitudRecuperada").value);

            const diametro = parseInt(document.getElementById("Diametro").value);
            const cajas = parseInt(document.getElementById("NumeroCajas").value);

            const tcr = parseFloat(document.getElementById("TCR").value);
            @* const intervalos = parseInt(document.getElementById("Intervalos").value); *@

            // LATITUD
            if(isNaN(lat) || lat < 14 || lat > 33){
                marcarInvalido("Latitud","Latitud fuera de rango (14 a 33).");
                valido = false;
            }

            // LONGITUD
            if(isNaN(lon) || lon < -118 || lon > -86){
                marcarInvalido("Longitud","Longitud fuera de rango (-118 a -86).");
                valido = false;
            }

            // ALTITUD
            if(isNaN(alt) || alt <= 0){
                marcarInvalido("Altitud","Altitud debe ser mayor a 0.");
                valido = false;
            }

            // AZIMUT
            if(isNaN(azimut) || azimut < 0 || azimut > 360){
                marcarInvalido("Azimut","Azimut debe estar entre 0° y 360°.");
                valido = false;
            }

            // INCLINACION
            if(isNaN(inclinacion) || inclinacion > 0 || inclinacion < -90){
                marcarInvalido("Inclinacion","La inclinación debe estar entre 0° y -90°.");
                valido = false;
            }

            // FECHAS
            if(fechaInicio && fechaFin){

                const f1 = new Date(fechaInicio);
                const f2 = new Date(fechaFin);

                if(f2 < f1){
                    marcarInvalido("FechaFin","La fecha de finalización no puede ser menor a la de inicio.");
                    valido = false;
                }

            }

            // LONGITUD PERFORADA
            if(isNaN(longitudP) || longitudP <= 0){
                marcarInvalido("Longitud_p","Debe ser mayor a 0.");
                valido = false;
            }

            // LONGITUD RECUPERADA
            if(isNaN(longitudR) || longitudR <= 0){
                marcarInvalido("Longitud_r","Debe ser mayor a 0.");
                valido = false;
            }

            // DIÁMETRO
            if(isNaN(diametro) || diametro <= 0){
                marcarInvalido("Diametro","El diámetro debe ser mayor a 0.");
                valido = false;
            }

            // CAJAS
            if(isNaN(cajas) || cajas <= 0){
                marcarInvalido("NumeroCajas","Debe haber al menos una caja.");
                valido = false;
            }

            // TCR
            if(isNaN(tcr) || tcr < 0 || tcr > 100){
                marcarInvalido("TCR","El TCR debe estar entre 0 y 100.");
                valido = false;
            }

            // INTERVALOS
            @* if(isNaN(intervalos) || intervalos <= 0){
                marcarInvalido("Intervalos","Debe ser mayor a 0.");
                valido = false;
            } *@

            return valido;

        }

        function marcarInvalido(id,mensaje){

            const input = document.getElementById(id);

            input.classList.add("is-invalid");

            let error = input.nextElementSibling;

            if(!error || !error.classList.contains("invalid-feedback")){

                error = document.createElement("div");
                error.className = "invalid-feedback";

                input.parentElement.appendChild(error);
            }

            error.innerText = mensaje;

        }

        function limpiarValidaciones(){

            const inputs = document.querySelectorAll("#formBarrenacion input, #formBarrenacion select");

            inputs.forEach(input =>{

                input.classList.remove("is-invalid");

                const feedback = input.parentElement.querySelector(".invalid-feedback");

                if(feedback) feedback.remove();

            });

        }

        function validarCoordenadasBarrenacion(){

            const lat = parseFloat(document.getElementById("Latitud").value);
            const lon = parseFloat(document.getElementById("Longitud").value);

            // LIMPIAR VALIDACIONES ANTES DE VALIDAR
            latInput.classList.remove("is-invalid","is-valid");
            lonInput.classList.remove("is-invalid","is-valid");

            limpiarErrorCoordenadaBarrenacion();

            if(isNaN(lat) || isNaN(lon)) return;

            if(lat < 14 || lat > 33 || lon < -118.5 || lon > -86){

                marcarInvalido("Latitud","Coordenadas fuera de México.");
                marcarInvalido("Longitud","Coordenadas fuera de México");

                return;
            }

            const punto = turf.point([lon,lat]);

            const estado = estados.features.find(e => 
                e.properties.CVE_ENT == estadoIdNormalizado
            );

            let dentroMexico = false;

            if (estado.geometry.type === "Polygon") {
                dentroMexico = turf.booleanPointInPolygon(
                    punto,
                    turf.polygon(estado.geometry.coordinates)
                );
            } else {
                dentroMexico = estado.geometry.coordinates.some(pol =>
                    turf.booleanPointInPolygon(
                        punto,
                        turf.polygon(pol)
                    )
                );
            }

            if(!dentroMexico){

                mostrarErrorCoordenadaBarrenacion(
                    "La coordenada no pertenece al territorio nacional."
                );

                return;
            }

            limpiarErrorCoordenadaBarrenacion();

        }

