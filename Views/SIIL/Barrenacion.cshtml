        function calcularTCR(){

            const pInput = document.getElementById("LongitudPerforada");
            const rInput = document.getElementById("LongitudRecuperada");
            const tcrInput = document.getElementById("TCR");

            const p = parseFloat(pInput.value);
            const r = parseFloat(rInput.value);

            limpiarAdvertencia("TCR");

            // limpiar errores anteriores
            limpiarInvalido("LongitudRecuperada");

            if(isNaN(p) || p <= 0){
                tcrInput.value = "";
                return;
            }

            if(isNaN(r) || r <= 0){
                tcrInput.value = "";
                return;
            }

            if(r > p){

                marcarInvalido(
                    "LongitudRecuperada",
                    "La longitud recuperada no puede ser mayor que la perforada."
                );

                tcrInput.value = "";
                return;
            }

            const tcr = (r / p) * 100;

            tcrInput.value = tcr.toFixed(2);

            // activar advertencias geológicas automáticamente
            @* validarTCRGeologico(); *@

        }

