            const feedback = input.parentElement.querySelector(".invalid-feedback");

            if(feedback) feedback.remove();

        }

        function agregarFila() {
            const tbody = document.querySelector("#tablaIntervalos tbody");
            const longitudPerforadaInput = document.getElementById("LongitudPerforada");

            const index = tbody.querySelectorAll("tr").length;

            // 🔥 Obtener valor anterior de "Hasta"
            let desde = 0;

            if (index > 0) {
                const ultimaFila = tbody.querySelectorAll("tr")[index - 1];
                const ultimoHasta = ultimaFila.querySelector(".input-hasta").value;

                desde = parseFloat(ultimoHasta) || 0;
            }

            if (index > 0) {
                const ultima = tbody.querySelectorAll("tr")[index - 1];
                const hasta = ultima.querySelector(".input-hasta").value;

                if (!hasta) {
                    alert("Debes completar el intervalo actual antes de agregar otro.");
                    return;
                }
            }

            const fila = `
                <tr>
                    <td>
                        <input type="text"
                            name="Intervalos[${index}].Nombre"
                            class="form-control input-nombre"
                            value="INT-${String(index + 1).padStart(2, '0')}"
                            readonly />
                    </td>

                    <td>
                        <input type="number"
                            step="0.01"
                            name="Intervalos[${index}].Desde"
                            class="form-control input-desde"
                            value="${desde}"
                            readonly />
                    </td>

                    <td>
                        <input type="number"
                            step="0.01"
                            name="Intervalos[${index}].Hasta"
                            class="form-control input-hasta"
                            min="${desde}"
                            onblur="validarIntervaloIndividual(this)"
                            required />
                    </td>

                    <td class="text-center">

                        <input type="checkbox"
                            class="form-check-input input-interes"
                            name="Intervalos[${index}].EsInteres"
                            value="true" />

                    </td>

                    <td>
                        <button type="button"
                            class="btn btn-danger btn-sm"
                            onclick="eliminarFila(this)">
                            X
                        </button>
                    </td>
                </tr>
            `;

            tbody.insertAdjacentHTML("beforeend", fila);

            //validarIntervalos();
        }

        function eliminarFila(btn) {
            const fila = btn.closest("tr");
            fila.remove();

            reordenarIntervalos();
            //validarIntervalos();
        }

        function reordenarIntervalos() {
            const tbody = document.querySelector("#tablaIntervalos tbody");
            const filas = tbody.querySelectorAll("tr");

            let desde = 0;

            filas.forEach((fila, index) => {
                const nombre = fila.querySelector(".input-nombre");
                const inputDesde = fila.querySelector(".input-desde");
                const inputHasta = fila.querySelector(".input-hasta");

                // 🔥 Renumerar nombres
                nombre.value = `INT-${String(index + 1).padStart(2, '0')}`;
                nombre.name = `Intervalos[${index}].Nombre`;

                // 🔥 Recalcular DESDE
                inputDesde.value = desde;
                inputDesde.name = `Intervalos[${index}].Desde`;

                // 🔥 Reasignar HASTA
                inputHasta.name = `Intervalos[${index}].Hasta`;
                inputHasta.min = desde;

                // 🔥 Checkbox
                const checkbox = fila.querySelector('.input-interes');

                checkbox.name = `Intervalos[${index}].EsInteres`;

                desde = parseFloat(inputHasta.value) || desde;
            });
        }

        function validarIntervalos() {
            const tbody = document.querySelector("#tablaIntervalos tbody");
            const filas = tbody.querySelectorAll("tr");

            const longitudPerforada =
                parseFloat(document.getElementById("LongitudPerforada").value) || 0;

            if (filas.length === 0) {
                alert("Debe existir al menos un intervalo.");
                return false;
            }

            let ultimoHasta = 0;

            for (let i = 0; i < filas.length; i++) {
                const fila = filas[i];

                const desde =
                    parseFloat(fila.querySelector(".input-desde").value) || 0;

                const hastaRaw = fila.querySelector(".input-hasta").value;

                // 🔥 SI NO HA ESCRITO TODAVÍA → IGNORAR
                if (!hastaRaw) continue;

                const hasta = parseFloat(hastaRaw);

                if (hasta <= desde) {
                    alert(`El intervalo INT-${String(i + 1).padStart(2, '0')} tiene valores inválidos.`);
                    return false;
                }

                if (longitudPerforada > 0 && hasta > longitudPerforada) {
                    alert(`El intervalo INT-${String(i + 1).padStart(2, '0')} supera la Longitud Perforada.`);
                    return false;
                }

                ultimoHasta = hasta;
            }

            return true;
        }

        function validarIntervalosFinal() {
            const tbody = document.querySelector("#tablaIntervalos tbody");
            const filas = tbody.querySelectorAll("tr");

            const longitudPerforada =
                parseFloat(document.getElementById("LongitudPerforada").value) || 0;

            if (filas.length === 0) {
                alert("Debe existir al menos un intervalo.");
                return false;
            }

            let ultimoHasta = 0;

            for (let i = 0; i < filas.length; i++) {
                const fila = filas[i];

                const desde =
                    parseFloat(fila.querySelector(".input-desde").value) || 0;

                const hastaRaw = fila.querySelector(".input-hasta").value;

                // 🔴 AQUÍ SÍ ES OBLIGATORIO
                if (!hastaRaw) {
                    alert(`Debe completar el intervalo INT-${String(i + 1).padStart(2, '0')}`);
                    return false;
                }

                const hasta = parseFloat(hastaRaw);

                if (hasta <= desde) {
                    alert(`El intervalo INT-${String(i + 1).padStart(2, '0')} tiene valores inválidos.`);
                    return false;
                }

                if (hasta > longitudPerforada) {
                    alert(`El intervalo INT-${String(i + 1).padStart(2, '0')} supera la Longitud Perforada.`);
                    return false;
                }

                ultimoHasta = hasta;
            }

            if (longitudPerforada > 0 && ultimoHasta !== longitudPerforada) {
                alert("Los intervalos deben cubrir exactamente la Longitud Perforada.");
                return false;
            }

            return true;
        }

        function validarIntervaloIndividual(input) {

            const fila = input.closest("tr");
            const tbody = document.querySelector("#tablaIntervalos tbody");

            const longitudPerforadaInput = document.getElementById("LongitudPerforada");
            const longitudPerforada = parseFloat(longitudPerforadaInput.value);

            const desde = parseFloat(fila.querySelector(".input-desde").value) || 0;
            const hasta = parseFloat(input.value);

            // 🔴 1. No hay longitud perforada
            if (!longitudPerforada || longitudPerforada <= 0) {
                alert("Primero debes ingresar la Longitud Perforada.");

                input.value = ""; // 🔥 limpiar
                return;
            }

            // 🔴 2. Valor inválido
            if (!hasta || hasta <= desde) {
                alert("El valor 'Hasta' debe ser mayor que 'Desde'.");

                input.value = "";
                return;
            }

            // 🔴 3. Se pasa del límite
            if (hasta > longitudPerforada) {
                alert("El intervalo supera la Longitud Perforada.");

                input.value = ""; // 🔥 limpiar automáticamente
                return;
            }

            // 🔥 4. Ajustar siguiente fila automáticamente (UX PRO)
            const filas = tbody.querySelectorAll("tr");
            const index = Array.from(filas).indexOf(fila);

            if (index < filas.length - 1) {
                const siguienteFila = filas[index + 1];
                const siguienteDesde = siguienteFila.querySelector(".input-desde");

                siguienteDesde.value = hasta;
            }
        }

        document.getElementById("LongitudPerforada")
            .addEventListener("change", function () {

                const tbody = document.querySelector("#tablaIntervalos tbody");

                // 🔥 limpiar todo
                tbody.innerHTML = "";

                // 🔥 crear intervalo inicial limpio
                agregarFila();

                alert("Se reiniciaron los intervalos porque cambió la Longitud Perforada.");
            });

        function inicializarIntervalos() {
            const tbody = document.querySelector("#tablaIntervalos tbody");

            // 🔥 Siempre crear uno por defecto
            if (tbody.querySelectorAll("tr").length === 0) {
                agregarFila();
            }

            // 🔥 Validar antes de enviar form
            @* document.querySelector("form").addEventListener("submit", function (e) {
                if (!validarIntervalos()) {
                    e.preventDefault();
                }
            }); *@
        }

    </script>
