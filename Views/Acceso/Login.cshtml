@{
    ViewData["Title"] = "Acceso al Sistema Nacional de Información Energética";
    Layout = null;
    var cdn = "https://cdn.sassoapps.com";
}


<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description"
        content="Plataforma oficial para integrar, analizar y transparentar toda la información energética de México">

    <!-- Bootstrap 5.3 + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- Particles.js for modern background effects -->
    <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Poppins:wght@600;700&display=swap"
        rel="stylesheet">
    <!-- SNIER System CSS - Incluye todos los estilos del sistema -->
    <link rel="stylesheet" href="~/css/snier.css" asp-append-version="true" />

    <!-- Única personalización específica para Botpress -->
    <style>
        a[href*="https://botpress.com/?from=webchat"] {
            display: none !important;
        }
    </style>

</head>

<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="@cdn/img_snier/login/logo_snier.png" alt="SNIER" class="navbar-logo">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#inicio">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#modulos">Módulos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#beneficios">Beneficios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#acceso">Acceso</a>
                    </li>
                </ul>
                <a href="#acceso" class="btn btn-primary ms-lg-3">Iniciar sesión</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section" id="inicio">
        <div id="particles-js"></div>
        <div class="container-fluid px-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 hero-content" data-aos="fade-right" data-aos-duration="1000">
                    <div class="hero-title-container">
                        <img src="@cdn/img_snier/login/logo_snier.png" alt="SNIER Logo" class="hero-logo"
                            data-aos="zoom-in" data-aos-delay="100">
                        <h1 class="hero-title text-white" data-aos="fade-up" data-aos-delay="200">
                            Sistema Nacional de
                            <span class="text-gradient">Información Energética</span>
                        </h1>
                    </div>
                    <p class="hero-description" data-aos="fade-up" data-aos-delay="400">
                        Plataforma oficial para integrar, analizar y transparentar toda la información
                        energética de México con tecnología de vanguardia
                    </p>
                    <div class="hero-actions" data-aos="fade-up" data-aos-delay="600">
                        <a href="#acceso" class="login-btn-primary">
                            <i class="bi bi-play-circle"></i>Acceder al sistema
                        </a>
                        <a href="#modulos" class="login-btn-outline">
                            <i class="bi bi-grid-3x3-gap"></i>Ver módulos
                        </a>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left" data-aos-duration="1000" data-aos-delay="300">
                    <div class="login-video-container">
                        <video class="login-video" controls autoplay muted loop
                            poster="@cdn/img_snier/login/logo_snier.png" preload="auto">
                            <source src="https://cdn.sassoapps.com/video/SNIER%202025.mp4" type="video/mp4">
                            <p>Tu navegador no soporta videos HTML5.
                                <a href="https://cdn.sassoapps.com/video/SNIER%202025.mp4">Descarga el
                                    video</a>.
                            </p>
                        </video>
                        <div class="login-video-description">
                            <small class="text-shadow">
                                <i class="bi bi-camera-video me-2"></i>
                                <strong>Sistema Nacional de Información Energética</strong>
                                <span class="mx-2">•</span>
                                <em>Video Oficial 2025</em>
                                <span class="mx-2">•</span>
                                <span class="badge bg-success">HD</span>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6" data-aos="fade-up">
                    <div class="stats-item">
                        <i class="bi bi-grid-3x3-gap-fill stats-icon"></i>
                        <div class="stats-number">15+</div>
                        <div class="stats-label">Módulos especializados</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="stats-item">
                        <i class="bi bi-server stats-icon"></i>
                        <div class="stats-number">500K+</div>
                        <div class="stats-label">Registros energéticos</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="stats-item">
                        <i class="bi bi-geo-alt-fill stats-icon"></i>
                        <div class="stats-number">32</div>
                        <div class="stats-label">Entidades federativas</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="stats-item">
                        <i class="bi bi-clock-history stats-icon"></i>
                        <div class="stats-number">24/7</div>
                        <div class="stats-label">Datos actualizados</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Modules Section -->
    <section class="modules-section" id="modulos">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">
                    <span class="bg-light px-4">Módulos del SNIER</span>
                </h2>
                <p class="section-description">Explora las herramientas especializadas del Sistema Nacional de
                    Información
                    Energética
                </p>
            </div>

            <!-- Módulos Principales -->
            <div class="mb-5">
                <h3 class="modules-category-title">📊 Módulos de Información</h3>
                <div class="row g-4">
                    <!-- El inventario y el potencial de los recursos renovables -->
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <video autoplay loop muted class="module-card-video">
                                    <source src="https://cdn.sassoapps.com/video/Login_snier.mp4" type="video/mp4">
                                </video>
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-sun module-icon"></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Inventario y Potencial de Recursos Renovables</h4>
                                <p>Atlas de recursos renovables, exploración, extracción, explotación, producción,
                                    transformación,
                                    transporte, almacenamiento, distribución y consumo final.</p>
                                <div class="module-footer">
                                    <span class="badge badge-success">Disponible</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- El origen y el destino de la energía -->
                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="https://images.pexels.com/photos/1098518/pexels-photo-1098518.jpeg"
                                    alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-diagram-3 module-icon"></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Origen y Destino de la Energía</h4>
                                <p>Visualiza el flujo energético a lo largo de toda la cadena de valor nacional y
                                    sectorial.</p>
                                <div class="module-footer">
                                    <span class="badge bg-info">Interactivo</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información sobre el Mercado Eléctrico Mayorista -->
                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="https://images.pexels.com/photos/207489/pexels-photo-207489.jpeg"
                                    alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-lightning-charge module-icon"></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Mercado Eléctrico Mayorista</h4>
                                <p>Información estadística sobre precios, ofertas, demanda y operación del mercado
                                    eléctrico nacional.</p>
                                <div class="module-footer">
                                    <span class="badge bg-warning">Tiempo Real</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Seguimiento a instrumentos de planeación energética -->
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="https://images.pexels.com/photos/3183153/pexels-photo-3183153.jpeg"
                                    alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-graph-up-arrow module-icon"></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Planeación Energética y Proyectos Estratégicos</h4>
                                <p>Seguimiento a instrumentos de planeación energética y avance de proyectos
                                    estratégicos nacionales.</p>
                                <div class="module-footer">
                                    <span class="badge bg-primary">Estratégico</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sistemas Especializados -->
                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="https://images.pexels.com/photos/12747835/pexels-photo-12747835.jpeg"
                                    alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-piggy-bank module-icon"></i>
                            </div>
                            <div class="module-card-content">
                                <h4>FOTEASE</h4>
                                <h6 class="text-muted small mb-2">Fondo para la Transición Energética y el
                                    Aprovechamiento Sustentable de la Energía</h6>
                                <p>Instrumento financiero para promover proyectos de eficiencia energética, energías
                                    renovables y transición energética nacional.</p>
                                <div class="module-footer">
                                    <span class="badge bg-success">Financiero</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="https://images.pexels.com/photos/12319814/pexels-photo-12319814.jpeg"
                                    alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-file-earmark-text module-icon"></i>
                            </div>
                            <div class="module-card-content">
                                <h4>FSUE</h4>
                                <p>Fondo del Servicio Universal de Energía para comunidades rurales y aisladas del país.
                                </p>
                                <div class="module-footer">
                                    <span class="badge bg-success">Social</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="https://images.pexels.com/photos/1762815/pexels-photo-1762815.jpeg"
                                    alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-lightbulb module-icon"></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Fondos de I+D</h4>
                                <p>Fondos de Investigación y Desarrollo para innovación tecnológica en el sector
                                    energético.</p>
                                <div class="module-footer">
                                    <span class="badge bg-info">Innovación</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Registros y Certificaciones -->
            <div class="mb-5">
                <h3 class="modules-category-title">🏆 Registros y Certificaciones</h3>
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="https://images.pexels.com/photos/1108572/pexels-photo-1108572.jpeg"
                                    alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-award module-icon "></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Certificados de Energías Limpias</h4>
                                <p>Registro público de CELs, participantes obligados y cumplimiento de metas de energías
                                    limpias.
                                </p>
                                <div class="module-footer">
                                    <span class="badge bg-success">Oficial</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="@cdn/img_snier/login/innovacion.png" alt="Placeholder"
                                    class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-gear-wide-connected module-icon "></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Catálogo de Tecnologías</h4>
                                <p>Tecnologías para generación de electricidad y habilitadoras del sector energético.
                                </p>
                                <div class="module-footer">
                                    <span class="badge bg-success">Catálogo</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="@cdn/img_snier/login/escenarios.png" alt="Placeholder"
                                    class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-bar-chart-steps module-icon "></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Escenarios Energéticos</h4>
                                <p>Escenarios de referencia a mediano y largo plazo del sector energético nacional.</p>
                                <div class="module-footer">
                                    <span class="badge bg-success">Prospectivo</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Eficiencia Energética -->
            <div class="mb-5">
                <h3 class="modules-category-title">⚡ Eficiencia Energética</h3>
                <div class="row g-4">
                    <div class="col-lg-3 col-md-6" data-aos="fade-up">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="@cdn/img_snier/login/combustibles.png" alt="Placeholder"
                                    class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-fuel-pump module-icon "></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Combustibles y Poderes Caloríficos</h4>
                                <p>Lista completa con características técnicas y energéticas.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="@cdn/img_snier/login/aparatos.png" alt="Placeholder"
                                    class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-tools module-icon "></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Catálogo de Equipos</h4>
                                <p>Aparatos relevantes para consumo de energía y unidades comercializadas.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="@cdn/img_snier/login/instalaciones.png" alt="Placeholder"
                                    class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-building module-icon "></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Registro de Instalaciones</h4>
                                <p>Edificaciones, empresas y productos de eficiencia energética.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="module-card">
                            <div class="module-card-video-wrapper">
                                <img src="@cdn/img_snier/login/ahorros.png" alt="Placeholder" class="module-card-video">
                            </div>
                            <div class="module-icon-wrapper">
                                <i class="bi bi-arrow-down-circle module-icon "></i>
                            </div>
                            <div class="module-card-content">
                                <h4>Medidas de Reducción</h4>
                                <p>Ahorros generados por medidas de reducción en intensidad energética.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Funciones del Consejo -->
            <div class="governance-section">
                <div class="text-center mb-4">
                    <h3 class="modules-category-title">🏛️ Funciones del Consejo SNIEr</h3>
                    <p class="text-muted">En el apartado de consejo del SNIEr se cuenta con funciones que apoyan al
                        seguimiento en cada una de las etapas del Consejo.</p>
                </div>

                <!-- Flujo principal del proceso -->
                <div class="row g-3 mb-4">
                    <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up">
                        <div class="governance-card text-dark">
                            <div class="governance-icon">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <h6>Convocatoria y orden del día</h6>
                            <p class="small">Programación y organización de sesiones del consejo</p>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="governance-card text-dark">
                            <div class="governance-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                            <h6>Documentación soporte de los temas a tratar</h6>
                            <p class="small">Preparación de materiales y documentos de apoyo</p>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="governance-card text-dark">
                            <div class="governance-icon">
                                <i class="bi bi-people"></i>
                            </div>
                            <h6>Sesión</h6>
                            <p class="small">Desarrollo de las sesiones ordinarias y extraordinarias</p>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="300">
                        <div class="governance-card text-dark">
                            <div class="governance-icon">
                                <i class="bi bi-clipboard-check"></i>
                            </div>
                            <h6>Registro de acuerdos</h6>
                            <p class="small">Documentación oficial de decisiones y compromisos</p>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="400">
                        <div class="governance-card text-dark">
                            <div class="governance-icon">
                                <i class="bi bi-arrow-repeat"></i>
                            </div>
                            <h6>Seguimiento de acuerdos</h6>
                            <p class="small">Monitoreo del cumplimiento de compromisos</p>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-4 col-sm-6" data-aos="fade-up" data-aos-delay="500">
                        <div class="governance-card text-dark">
                            <div class="governance-icon">
                                <i class="bi bi-file-earmark-bar-graph"></i>
                            </div>
                            <h6>Informe anual de actividades</h6>
                            <p class="small">Reporte consolidado de gestión y resultados</p>
                        </div>
                    </div>
                </div>

                <!-- Funciones específicas del SNIEr -->
                <div class="text-center mb-4 mt-5">
                    <h4 class="fw-bold">Funciones del SNIEr</h4>
                    <p class="text-muted">Herramientas de apoyo para cada etapa del proceso</p>
                </div>

                <div class="functions-list">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="function-row" data-aos="fade-right">
                                <div class="function-badge">
                                    <i class="bi bi-inbox"></i>
                                </div>
                                <div class="function-info">
                                    <h6>Buzón de asuntos</h6>
                                    <p>Sistema de recepción y gestión de temas para el consejo</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="function-row" data-aos="fade-left">
                                <div class="function-badge">
                                    <i class="bi bi-database"></i>
                                </div>
                                <div class="function-info">
                                    <h6>Repositorio de información</h6>
                                    <p>Archivo digital de documentos y antecedentes del consejo</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="function-row" data-aos="fade-right" data-aos-delay="100">
                                <div class="function-badge">
                                    <i class="bi bi-person-check"></i>
                                </div>
